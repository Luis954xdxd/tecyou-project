PORT=5000

# Frontend permitido para consumir la API.
# Local:
CORS_ORIGIN=http://localhost:3000
# Produccion, ejemplo:
# CORS_ORIGIN=https://tecyou.vercel.app

DB_USER=postgres
DB_PASSWORD=change_me
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tecyou

# Alternativa para proveedores cloud que entregan una cadena de conexion.
# Si DATABASE_URL existe, el backend la usa en lugar de DB_USER/DB_HOST/etc.
DATABASE_URL=
DB_SSL=false
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000

# En produccion usa una ruta persistente del hosting.
# Render ejemplo: /opt/render/project/src/uploads
# Railway con volumen ejemplo: /data/uploads
UPLOADS_DIR=

OPENAI_API_KEY=
OPENAI_MODEL=

# Opcional: desactiva el proceso local de moderacion si el hosting no tiene Python.
# AUTO_START_MODERATION=false

# La cuenta indicada aqui recibe super_admin al iniciar sesion.
SUPER_ADMIN_EMAIL=correo.institucional@zapopan.tecmm.edu.mx

# Usa una cadena larga y aleatoria en cada instalacion.
SESSION_SECRET=change_this_for_a_long_random_secret
